  sub r f f by r_f_f;
  sub r f by r_f;
  sub r t by r_t;
  sub t f by t_f;
  sub t t by t_t;
  ignore sub @dlig kappa' alpha' iota';
  ignore sub kappa' alpha' iota' @dlig;
  ignore sub @dlig2 kappa' alpha' iota';
  ignore sub kappa' alpha' iota' @dlig2;
  ignore sub @dlig3 kappa' alpha' iota';
  ignore sub kappa' alpha' iota' @dlig3;
  sub @calt_case_dlig_locl kappa' alpha' iota' @calt_case_dlig_locl by kaiSymbol;
  sub [hyphen.cap endash.cap emdash.cap space] Kappa' Alpha' Iota' [hyphen.cap endash.cap emdash.cap space] by KaiSymbol;
  sub @calt_case_dlig_locl kappa.sc' alpha.sc' iota.sc' @calt_case_dlig_locl by kaiSymbol.sc;";
tag = dlig;
},
{

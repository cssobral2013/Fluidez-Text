  sub g underscore l o g o by g.logo;
  sub l underscore l o g o by l.logo;
  sub o underscore l o g o by o.logo;
  sub s u p e r underscore G underscore l o g o by G.super;
  sub s u p e r underscore g underscore l o g o by G.super;
  sub @calt_case_dlig_locl etatonos.sc' @calt_case_locl by etatonos.sc.ss06;
  sub @calt_dnom_frac_numr_sinf_subs_sups colon' @calt_dnom_frac_numr_sinf_subs_sups by colon.time;
  sub @calt colon' @calt by colon.time;

{
code = "# GSUB feature: Discretionary Ligatures
# Lookups: 3

  sub f f b by f_f_b;
  sub f f h by f_f_h;
  sub f f j by f_f_j;
  sub f f k by f_f_k;
  sub f f t by f_f_t;
  sub f b by f_b;
  sub f h by f_h;
  sub f i by fi;
  sub f j by f_j;
  sub f k by f_k;
  sub f l by fl;
  sub f t by f_t;
  sub r f f by r_f_f;
  sub r f by r_f;
  sub r t by r_t;
  sub t f by t_f;
  sub t t by t_t;
  ignore sub @dlig kappa' alpha' iota';
  ignore sub kappa' alpha' iota' @dlig;
  ignore sub @dlig2 kappa' alpha' iota';
  ignore sub kappa' alpha' iota' @dlig2;
  ignore sub @dlig3 kappa' alpha' iota';
  ignore sub kappa' alpha' iota' @dlig3;
  sub @calt_case_dlig_locl kappa' alpha' iota' @calt_case_dlig_locl by kaisymbol;
  sub [hyphen.cap endash.cap emdash.cap space] Kappa' Alpha' Iota' [hyphen.cap endash.cap emdash.cap space] by Kaisymbol;
  sub @calt_case_dlig_locl kappa.sc' alpha.sc' iota.sc' @calt_case_dlig_locl by kaisymbol.sc;

  lookup dlig_6 {
  # GSUB lookup 72, type 14 (Ligature)
    lookupflag IgnoreMarks;
    sub uni05D0 uni05DC by uniFB4F;
    sub uni05D5 uni05D5 by uni05F0;
    sub uni05D9 uni05D5 by uni05F1;
    sub uni05D9 uni05D9 by uni05F2;
  } dlig_6;";
tag = dlig;
},
{
